# Board: Generic ESP32 Board (Generic)
# Definition: definitions/boards/generic-esp32/manifest.yaml

esphome:
  name: akva-hnojeni
  friendly_name: "Akva Hnojení"
  on_shutdown:
    then:
      - switch.turn_off: pump1_relay
      - switch.turn_off: pump2_relay
      - switch.turn_off: pump3_relay
      - switch.turn_off: pump4_relay

esp32:
  board: esp32dev
  framework:
    type: arduino

logger:

api:
  encryption:
    key: "your_key"

ota:
  - platform: esphome

wifi:
  id: wifi_comp
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: Akva-Hnojeni-Fallback
    password: tvoje_heslo
captive_portal:

